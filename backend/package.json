{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "worker": "node worker/index.js",
    "start:worker": "node worker/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "smoke:bullmq": "node scripts/smoke-bullmq-real.js",
    "db:migrate:sql": "node scripts/run-sql-migrations.js",
    "locations:import": "node scripts/import-location-catalog.js",
    "test:runtime-boundary": "node scripts/validate-runtime-boundary.js",
    "test:runtime-boundary:core": "node scripts/validate-runtime-boundary.js --core-only",
    "smoke:organization-mapping-image": "docker build -f Dockerfile -t civitas-backend-318 .. && docker run --rm --entrypoint node civitas-backend-318 -e \"require('/core/organization-mapping/index.cjs'); console.log('organization-mapping-load-ok')\"",
    "locations:ensure": "node scripts/ensure-location-catalog.js",
    "db:bootstrap": "npm run db:migrate:sql && npm run locations:ensure",
    "taxonomy:contract-check": "node ../scripts/taxonomy/contract-check.js && node --test test/authz-taxonomy-contract.test.js",
    "taxonomy:migration-check": "node ../scripts/taxonomy/migration-check.js",
    "organization-structure:contract-check": "node ../scripts/organization-structure-contract-check.js && node --test test/authz-organization-structure-contract.test.js",
    "organization-structure:migration-check": "node ../scripts/organization-structure-migration-check.js",
    "authz:data-scope-contract-check": "node ../scripts/authz-data-scope-contract-check.js && node --test test/authz-data-scope-contract.test.js",
    "authz:data-scope-migration-check": "node ../scripts/authz-data-scope-migration-check.js",
    "organization-structure:data-scope-integration-check": "node ../scripts/organization-structure-data-scope-integration-check.js && node --test test/authz-organization-structure-data-scope-integration.test.js",
    "organization-structure:reconciliation-check": "node ../scripts/organization-structure-reconciliation-check.js",
    "authz:runtime-contract-check": "node ../scripts/authorization/check-runtime-contract.js && node --test test/authz-runtime-consistency-contract.test.js",
    "security:audit": "npm audit --audit-level=high",
    "security:audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ajv": "^8.17.1",
    "bullmq": "^5.58.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "ioredis": "^5.7.0",
    "jose": "^5.9.6",
    "pg": "^8.16.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  },
  "packageManager": "npm@12.0.1"
}
