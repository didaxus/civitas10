{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.civitas.local/delivery/application-service-registry.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "status",
    "lifecycle",
    "ownership",
    "provenance",
    "services"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "contractVersion": {
      "type": "string"
    },
    "status": {
      "const": "planned"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "deployment",
        "activation"
      ],
      "properties": {
        "implementation": {
          "const": "planned"
        },
        "deployment": {
          "const": "planned"
        },
        "activation": {
          "const": "planned"
        }
      }
    },
    "ownership": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityDocument",
        "issue",
        "decision"
      ],
      "properties": {
        "authorityDocument": {
          "type": "string",
          "minLength": 1
        },
        "sourceDocument": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "pattern": "^#"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "capabilityId",
          "applicationServiceId",
          "permissionId",
          "dataScopeStrategyId",
          "operation",
          "restOperationRefs",
          "mcp",
          "status",
          "lifecycle",
          "ownership",
          "provenance"
        ],
        "properties": {
          "moduleId": {
            "type": "string"
          },
          "capabilityId": {
            "type": "string"
          },
          "applicationServiceId": {
            "type": "string"
          },
          "permissionId": {
            "type": "string"
          },
          "dataScopeStrategyId": {
            "type": "string"
          },
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "effect"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "get",
                  "post",
                  "put",
                  "patch",
                  "delete"
                ]
              },
              "effect": {
                "enum": [
                  "read",
                  "write"
                ]
              }
            }
          },
          "restOperationRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document",
                "operationId",
                "method",
                "path"
              ],
              "properties": {
                "document": {
                  "type": "string"
                },
                "operationId": {
                  "type": "string"
                },
                "method": {
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "PATCH",
                    "DELETE"
                  ]
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                }
              }
            }
          },
          "mcp": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exposure",
              "toolRefs"
            ],
            "properties": {
              "exposure": {
                "enum": [
                  "none",
                  "curated"
                ]
              },
              "toolRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "document",
                    "toolId"
                  ],
                  "properties": {
                    "document": {
                      "type": "string"
                    },
                    "toolId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "status": {
            "const": "planned"
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "implementation",
              "deployment",
              "activation"
            ],
            "properties": {
              "implementation": {
                "const": "planned"
              },
              "deployment": {
                "const": "planned"
              },
              "activation": {
                "const": "planned"
              }
            }
          },
          "ownership": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authorityDocument",
              "issue",
              "decision"
            ],
            "properties": {
              "authorityDocument": {
                "type": "string",
                "minLength": 1
              },
              "sourceDocument": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "pattern": "^#"
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
