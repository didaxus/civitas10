{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civitas.didaxus.com/contracts/authorization/token-claims.schema.json",
  "title": "Civitas Organization Token Claims v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sub",
    "iss",
    "aud",
    "iat",
    "exp",
    "organization_id",
    "https://civitas.didaxus.com/claims/organization_membership_id",
    "https://civitas.didaxus.com/claims/organization_role_ids",
    "https://civitas.didaxus.com/claims/authz_contract_version"
  ],
  "properties": {
    "sub": {
      "type": "string",
      "minLength": 1
    },
    "iss": {
      "type": "string",
      "format": "uri"
    },
    "aud": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "iat": {
      "type": "integer"
    },
    "exp": {
      "type": "integer"
    },
    "organization_id": {
      "type": "string",
      "minLength": 1
    },
    "https://civitas.didaxus.com/claims/organization_membership_id": {
      "type": "string",
      "minLength": 1
    },
    "https://civitas.didaxus.com/claims/organization_role_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "https://civitas.didaxus.com/claims/authz_contract_version": {
      "const": "civitas-authorization-foundation/v2"
    }
  },
  "x-civitas-note": "Membership must be real Logto membership or trusted Civitas server binding."
}
