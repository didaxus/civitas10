{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civitas.didaxus.com/contracts/authorization/principal.schema.json",
  "title": "Civitas Authorization Principal v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "principalId", "principalType", "subject", "issuer", "audiences", "organizationId", "membershipBindingId", "membershipBindingSource", "organizationRoleIds", "scopes", "rolePaths", "authzContractVersion", "issuedAt", "expiresAt", "snapshotVersion", "provenance"],
  "properties": {
    "schemaVersion": { "const": "civitas-principal/v2" },
    "principalId": { "type": "string", "minLength": 8 },
    "principalType": { "enum": ["user", "agent", "system"] },
    "subject": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "format": "uri" },
    "audiences": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "organizationId": { "type": "string", "minLength": 1 },
    "membershipBindingId": { "type": "string", "minLength": 8 },
    "membershipBindingSource": { "enum": ["logto_claim", "civitas_server_binding"] },
    "organizationRoleIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rolePaths": { "type": "array", "minItems": 1, "items": { "$ref": "role-path.schema.json" } },
    "authzContractVersion": { "const": "civitas-authorization-foundation/v2" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "snapshotVersion": { "type": "integer", "minimum": 1 },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["bindingRecordVersion", "resolvedAt"],
      "properties": { "bindingRecordVersion": { "type": "string", "minLength": 1 }, "resolvedAt": { "type": "string", "format": "date-time" }, "tokenIdHash": { "type": "string" } }
    }
  }
}
