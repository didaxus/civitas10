{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.civitas.local/authorization/owner-scope-templates.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "contractVersion",
    "status",
    "lifecycle",
    "ownership",
    "provenance",
    "templates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "contractVersion": {
      "type": "string"
    },
    "status": {
      "const": "planned"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "deployment",
        "activation"
      ],
      "properties": {
        "implementation": {
          "const": "planned"
        },
        "deployment": {
          "const": "planned"
        },
        "activation": {
          "const": "planned"
        }
      }
    },
    "ownership": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityDocument",
        "issue",
        "decision"
      ],
      "properties": {
        "authorityDocument": {
          "type": "string",
          "minLength": 1
        },
        "sourceDocument": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "pattern": "^#"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "status",
          "publicationStatus",
          "availabilityGate",
          "canonicalRoleId",
          "capabilityIds",
          "permissionIds",
          "dataScopeStrategyId",
          "allowedTargetKinds",
          "allowedDimensionIds",
          "allowedRelationships",
          "riskLimits",
          "tenantMay",
          "ownership",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "const": "planned"
          },
          "publicationStatus": {
            "const": "planned"
          },
          "availabilityGate": {
            "type": "string"
          },
          "canonicalRoleId": {
            "type": "string"
          },
          "capabilityIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "permissionIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dataScopeStrategyId": {
            "type": "string"
          },
          "allowedTargetKinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedDimensionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedRelationships": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "riskLimits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tenantMay": {
            "const": "narrow_only"
          },
          "ownership": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authorityDocument",
              "issue",
              "decision"
            ],
            "properties": {
              "authorityDocument": {
                "type": "string",
                "minLength": 1
              },
              "sourceDocument": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "pattern": "^#"
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
