{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.civitas.local/authorization/data-scope-dimensions.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "contract",
    "version",
    "schemaVersion",
    "contractVersion",
    "status",
    "lifecycle",
    "ownership",
    "provenance",
    "dimensions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "const": "civitas.authorization.data-scope-dimensions"
    },
    "version": {
      "const": "2026-08-civitas-data-scope-dimensions-v3"
    },
    "schemaVersion": {
      "type": "string"
    },
    "contractVersion": {
      "type": "string"
    },
    "status": {
      "const": "planned"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "deployment",
        "activation"
      ],
      "properties": {
        "implementation": {
          "const": "planned"
        },
        "deployment": {
          "const": "planned"
        },
        "activation": {
          "const": "planned"
        }
      }
    },
    "ownership": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityDocument",
        "issue",
        "decision"
      ],
      "properties": {
        "authorityDocument": {
          "type": "string",
          "minLength": 1
        },
        "sourceDocument": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "pattern": "^#"
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "status",
          "tenantOwnership",
          "semanticDefinition",
          "valueLifecycle",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(academic|organization|administration|geography)\\.[a-z_]+$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "const": "planned"
          },
          "tenantOwnership": {
            "const": "organization"
          },
          "valueLifecycle": {
            "const": [
              "draft",
              "active",
              "deprecating",
              "archived"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authorityDocument",
              "issue",
              "decision"
            ],
            "properties": {
              "authorityDocument": {
                "type": "string",
                "minLength": 1
              },
              "sourceDocument": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "pattern": "^#"
              },
              "decision": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "semanticDefinition": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "deprecatedDimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "replacement",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "const": "deprecated"
          },
          "replacement": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  },
  "additionalProperties": false
}
