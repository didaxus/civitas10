{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civitas.didaxus.com/contracts/events/planning/plan-created.v1.schema.json",
  "title": "planning.plan.created.v1",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "organizationId", "actor", "correlationId", "sensitivity", "data"],
  "additionalProperties": false,
  "properties": {
    "eventId": { "type": "string" },
    "eventType": { "const": "planning.plan.created.v1" },
    "eventVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "organizationId": { "type": "string" },
    "actor": { "type": "object", "required": ["subjectId", "clientId"], "additionalProperties": false, "properties": { "subjectId": {"type":"string"}, "clientId": {"type":"string"} } },
    "correlationId": { "type": "string" },
    "decisionId": { "type": ["string", "null"] },
    "sensitivity": { "const": "internal" },
    "data": { "type": "object", "required": ["planId", "status"], "additionalProperties": false, "properties": { "planId": {"type":"string"}, "status": {"enum":["draft","approved"]} } }
  }
}
