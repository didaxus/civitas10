{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/validate-civitas-visual.mjs && node scripts/validate-tailwind-semantic-contract.mjs && node scripts/design-system/validate-intake-boundary.mjs && node scripts/design-system/validate-provenance.mjs && node scripts/validate-governance-visual-contract.mjs && node scripts/validate-navigation-contract.mjs",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.contract.test.mjs\"",
    "planning:p3-018:check": "node --test src/features/planning/planningRemote.contract.test.mjs && node scripts/module-ui/p3-012-gate.mjs authorization-parity && node scripts/module-ui/p3-011-gate.mjs accessibility",
    "preview": "vite preview",
    "validate:visual-backbone": "node scripts/validate-civitas-backbone.mjs",
    "validate:visual-contract": "node ../scripts/authorization/validate-visual-contract.js",
    "validate:frontend-authz": "node ../scripts/authorization/validate-frontend-authz.js",
    "validate:tailwind-contract": "node scripts/validate-tailwind-semantic-contract.mjs",
    "design:intake:map": "node scripts/design-system/map-tailwind-plus-palette.mjs",
    "design:provenance:check": "node scripts/design-system/validate-provenance.mjs",
    "design:intake:check": "node scripts/design-system/validate-intake-boundary.mjs",
    "validate:navigation-contract": "node scripts/validate-navigation-contract.mjs",
    "validate:governance-visual-contract": "node scripts/validate-governance-visual-contract.mjs",
    "validate:ecosystem": "node scripts/validate-react-ecosystem.mjs"
  },
  "dependencies": {
    "@logto/react": "4.0.14",
    "@tabler/icons-react": "3.45.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "autoprefixer": "10.5.4",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.13"
    },
    "ajv": "6.14.0"
  },
  "packageManager": "npm@12.0.1"
}
